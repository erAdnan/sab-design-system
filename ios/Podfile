# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, 15.1
prepare_react_native_project!

# Map custom Storybook build configurations to CocoaPods debug/release.
project 'SabDesignSystem',
  'Debug' => :debug,
  'Debug-SB' => :debug,
  'Release' => :release,
  'Release-SB' => :release

# React Native Firebase requires static frameworks.
$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SabDesignSystem' do
  config = use_native_modules!

  # Nitro MMKV (react-native-mmkv v4) + static frameworks: MMKVCore must emit
  # module maps so Swift NitroMmkv can import it.
  # See https://github.com/mrousavy/react-native-mmkv/blob/main/docs/V4_UPGRADE_GUIDE.md
  pod 'MMKVCore', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'SabDesignSystemTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt 11 + Apple Clang (Xcode 16/26): honor -DFMT_USE_CONSTEVAL=0 (see terminal: consteval/format.cc errors).
    fmt_base = File.expand_path('Pods/fmt/include/fmt/base.h', __dir__)
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      unless contents.include?('Wrapped: allow -DFMT_USE_CONSTEVAL=0')
        before = <<~'FMT'.chomp
          // Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.
          #if !defined(__cpp_lib_is_constant_evaluated)
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_CPLUSPLUS < 201709L
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_GLIBCXX_RELEASE && FMT_GLIBCXX_RELEASE < 10
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_LIBCPP_VERSION && FMT_LIBCPP_VERSION < 10000
          #  define FMT_USE_CONSTEVAL 0
          #elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L
          #  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14.
          #elif FMT_MSC_VERSION && FMT_MSC_VERSION < 1929
          #  define FMT_USE_CONSTEVAL 0  // consteval is broken in MSVC VS2019 < 16.10.
          #elif defined(__cpp_consteval)
          #  define FMT_USE_CONSTEVAL 1
          #elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101
          #  define FMT_USE_CONSTEVAL 1
          #else
          #  define FMT_USE_CONSTEVAL 0
          #endif
        FMT
        after = <<~'FMT'.chomp
          // Wrapped: allow -DFMT_USE_CONSTEVAL=0 to disable consteval (required for Apple Clang / Xcode 16+).
          #ifndef FMT_USE_CONSTEVAL
          // Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.
          #if !defined(__cpp_lib_is_constant_evaluated)
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_CPLUSPLUS < 201709L
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_GLIBCXX_RELEASE && FMT_GLIBCXX_RELEASE < 10
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_LIBCPP_VERSION && FMT_LIBCPP_VERSION < 10000
          #  define FMT_USE_CONSTEVAL 0
          #elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L
          #  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14.
          #elif FMT_MSC_VERSION && FMT_MSC_VERSION < 1929
          #  define FMT_USE_CONSTEVAL 0  // consteval is broken in MSVC VS2019 < 16.10.
          #elif defined(__cpp_consteval)
          #  define FMT_USE_CONSTEVAL 1
          #elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101
          #  define FMT_USE_CONSTEVAL 1
          #else
          #  define FMT_USE_CONSTEVAL 0
          #endif
          #endif
        FMT
        if contents.include?(before)
          File.chmod(File.stat(fmt_base).mode | 0o200, fmt_base)
          File.write(fmt_base, contents.sub(before, after))
        else
          Pod::UI.warn("fmt base.h: consteval block not found; skip fmt patch.")
        end
      end
    end

    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'

      target.build_configurations.each do |cfg|
        defs = cfg.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
        defs = ['$(inherited)'] if defs.nil?
        defs = [defs] if defs.is_a?(String)
        cfg.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs + ['FMT_USE_CONSTEVAL=0']
      end
    end

    # Xcode 15+/27: pods declaring older deployment targets fail the build.
    # Also: never let app provisioning profiles apply to Pods targets (CI manual signing).
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        deployment = cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment.nil? || deployment.to_f < 15.1
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
        # Firebase / third-party ObjC in static frameworks
        cfg.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        cfg.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        cfg.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        cfg.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
        cfg.build_settings['CODE_SIGN_IDENTITY'] = ''
        cfg.build_settings['CODE_SIGN_IDENTITY[sdk=appletvos*]'] = ''
        cfg.build_settings['CODE_SIGN_IDENTITY[sdk=iphoneos*]'] = ''
        cfg.build_settings['CODE_SIGN_IDENTITY[sdk=watchos*]'] = ''
        cfg.build_settings.delete('PROVISIONING_PROFILE_SPECIFIER')
        cfg.build_settings.delete('PROVISIONING_PROFILE')
      end
    end
  end
end
