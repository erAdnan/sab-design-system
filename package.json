{
  "name": "@sab/design-system",
  "version": "0.0.1",
  "description": "SAB Design System — React Native UI kit (components, foundations, theme, stories).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SABDigitalBank/sab-design-system.git"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./assets/*": "./src/assets/*",
    "./assets/*/*": "./src/assets/*/*",
    "./assets/*/*/*": "./src/assets/*/*/*",
    "./assets/*/*/*/*": "./src/assets/*/*/*/*",
    "./components/*": "./src/components/*",
    "./components/*/*": "./src/components/*/*",
    "./components/*/*/*": "./src/components/*/*/*",
    "./components/*/*/*/*": "./src/components/*/*/*/*",
    "./context/*": "./src/context/*",
    "./context/*/*": "./src/context/*/*",
    "./foundations": "./src/foundations/index.ts",
    "./foundations/*": "./src/foundations/*",
    "./localization/*": "./src/localization/*",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "stories",
    "examples"
  ],
  "scripts": {
    "start": "react-native start --reset-cache",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:web": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build -c .storybook",
    "storybook-generate": "sb-rn-get-stories --config-path .storybook",
    "storybook:ios": "yarn storybook-generate && node scripts/run-ios-variant.js --variant=sb",
    "storybook:android": "yarn storybook-generate && cross-env STORYBOOK_ENABLED=true react-native run-android --mode=sbDebug --appId=com.sabdesignsystem.sb",
    "bundle:install": "./scripts/run-bundle.sh install",
    "fastlane:storybook:android:apk": "yarn storybook-generate && cross-env STORYBOOK_ENABLED=true ENVFILE=.env.storybook ./scripts/run-bundle.sh exec fastlane android build_release",
    "fastlane:storybook:android:aab:store": "yarn storybook-generate && cross-env STORYBOOK_ENABLED=true ENVFILE=.env.storybook.prod ./scripts/run-bundle.sh exec fastlane android build_release",
    "fastlane:storybook:ios:ipa": "yarn storybook-generate && cross-env STORYBOOK_ENABLED=true ENVFILE=.env.storybook ./scripts/run-bundle.sh exec fastlane ios build_release",
    "fastlane:storybook:ios:ipa:store": "yarn storybook-generate && cross-env STORYBOOK_ENABLED=true ENVFILE=.env.storybook.prod ./scripts/run-bundle.sh exec fastlane ios build_release",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "peerDependencies": {
    "i18next": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@bottom-tabs/react-navigation": "1.3.1",
    "@callstack/liquid-glass": "^0.7.1",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@react-native-assets/slider": "^11.0.5",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-community/slider": "^4.5.3",
    "@react-native-firebase/analytics": "22.1.0",
