{
  "name": "@sab/design-system",
  "version": "0.1.0",
  "description": "SAB Design System — React Native UI kit (components, foundations, theme, stories).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SABDigitalBank/sab-design-system.git"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./assets/*": "./src/assets/*",
    "./assets/*/*": "./src/assets/*/*",
    "./assets/*/*/*": "./src/assets/*/*/*",
    "./assets/*/*/*/*": "./src/assets/*/*/*/*",
    "./components/*": "./src/components/*",
    "./components/*/*": "./src/components/*/*",
    "./components/*/*/*": "./src/components/*/*/*",
    "./components/*/*/*/*": "./src/components/*/*/*/*",
    "./context/*": "./src/context/*",
    "./context/*/*": "./src/context/*/*",
    "./foundations": "./src/foundations/index.ts",
    "./foundations/*": "./src/foundations/*",
    "./localization/*": "./src/localization/*",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "stories",
    "examples"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:web": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build -c .storybook",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "peerDependencies": {
    "i18next": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/addon-react-native-web": "^0.0.26",
    "@storybook/react": "^8.3.5",
    "@storybook/react-webpack5": "^8.3.5",
    "storybook": "^8.3.5"
  }
}
