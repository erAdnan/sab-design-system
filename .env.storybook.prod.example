# Storybook store release. CI writes .env.storybook.prod from ENV_STORYBOOK_PROD.
# Same keys as .env.storybook.example, with store distribution:

APP_NAME=SAB DS
APP_IDENTIFIER=com.sabdesignsystem.sb
APP_WORKSPACE=SabDesignSystem
APP_IOS_SCHEME=SABDS
APP_CONFIGURATION=Release-SB
IOS_SIGNING_TARGETS=SabDesignSystem
EXPORT_METHOD=app-store
APP_BUILD_NAME=SAB-DS

MATCH_GIT_URL=https://github.com/SABDigitalBank/certificates.git
MATCH_GIT_BRANCH=main
MATCH_TYPE=appstore
USE_MATCH=true
MATCH_PASSWORD=

ANDROID_TASK_TYPE=bundle
ANDROID_BUILD_TYPE=Release
ANDROID_FLAVOR=sb
ANDROID_FLAVOR_APK_PATH=./android/app/build/outputs/apk/sb/release/app-sb-release.apk
ANDROID_FLAVOR_AAB_PATH=./android/app/build/outputs/bundle/sbRelease/app-sb-release.aab
ANDROID_KEYSTORE_PATH=sbds-release-key.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEYSTORE_ALIAS=sbds-key-alias
ANDROID_KEYSTORE_ALIAS_PASSWORD=

BUILD_RELEASE_TYPE=store
FIREBASE_APP_ID_IOS=
FIREBASE_APP_ID_ANDROID=
FIREBASE_SERVICE_CRED_FILE_PATH=firebase/sab-digital-banking-ux-firebase-adminsdk-fbsvc-df4e162a30.json
SKIP_DISTRIBUTION=false
STORYBOOK_ENABLED=true
